{
  "grammars": [
    {
      "name": "klausur",
      "camelcase": "Klausur",
      "scope": "source.klausur",
      "path": ".",
      "file-types": ["kl"],
      "injection-regex": "^(klausur|kl)$",
      "highlights": "queries/klausur/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for klausur API test files",
    "links": { "repository": "https://github.com/arseeeeN/klausur" }
  },
  "bindings": { "c": false, "go": false, "node": false, "python": false, "rust": false, "swift": false }
}
